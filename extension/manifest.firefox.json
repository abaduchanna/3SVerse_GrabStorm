{
  "manifest_version": 3,
  "name": "TurboGrab Integration",
  "version": "1.2.0",
  "description": "Send download links to TurboGrab — the free & open download accelerator for Windows. Context-menu capture, automatic takeover of browser downloads.",
  "permissions": ["contextMenus", "downloads", "storage", "notifications"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "scripts": ["background.js"] },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TurboGrab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "turbograb@3sverse.com",
      "strict_min_version": "115.0"
    }
  }
}
